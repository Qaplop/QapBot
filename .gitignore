# Local-only helper scripts, notes, and working backups (never commit)
*.bat
*To_Do*
.workspace_tools/

# activity/ — Cloudflare Pages/Workers frontend+backend (CWL_CLAN_CONFIG_ACTIVITY_PLAN.md)
activity/**/node_modules/
activity/**/.wrangler/
activity/**/dist/

# wrangler CLI local cache/state (account id, deploy state) — created wherever `wrangler`/`npx
# wrangler` is invoked from, not just inside activity/; never source, never commit.
.wrangler/
activity/**/.dev.vars
activity/**/.env
activity/**/.env.local
activity/**/.env.*.local
.repo_*backup*/
.claude/

# Bug/feature tracker MCP server's local markdown/attachment mirror (BUG_FEATURE_TRACKER_PLAN.md
# §6.2) — reporter-uploaded content must never land in git.
.tracker-cache/

# Bug/feature tracker's own attachment storage (CONFIG.tracker_data_dir, default "tracker" at
# project root — moved off data/ on 2026-08-20, tracker item #0004, so it needed its own entry
# here since it's no longer covered by the data/ ignore above). Same "never commit" reason.
/tracker/

# Manual QA checklist's own browser Save-Progress state — personal local test progress, not
# repo content (the checklist itself, tests/cwl_enrollment_manual_qa_checklist.html, IS tracked).
tests/cwl-qa-checklist-progress.json