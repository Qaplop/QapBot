# Example environment variables for QapBot
# Copy to `.env` and fill in real values. Do NOT commit real secrets!

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_TOKEN_DEV=your_dev_bot_token_here
# DEV/PROD mode switch: test server guild ID = DEV mode (uses _DEV credentials, guild commands);
# 0 = PROD mode (uses PROD credentials, global commands). Keep it here in .env — do NOT set it
# as a machine-global environment variable (it would leak into every process and override .env).
DISCORD_GUILD_ID=your_test_server_guild_id_or_0_for_prod
DISCORD_GUILD_ID_FOR_CLEANUP=your_test_server_guild_id
DEV_PLAYERREGISTRATION_CHANNEL_ID=your_dev_channel_id_for_registration_testing

# Clash of Clans API (Production)
COC_API_EMAIL=your_coc_api_email
COC_API_PASSWORD=your_coc_api_password

# Clash of Clans API (Development)
COC_API_EMAIL_DEV=your_dev_coc_api_email
COC_API_PASSWORD_DEV=your_dev_coc_api_password

# Bot Configuration
# Preferred: your numeric Discord user ID (right-click your name > Copy User ID, with Developer Mode enabled).
# A username also works but is deprecated (usernames can be released and re-registered by others).
SERVER_ADMIN=your_discord_user_id
QAPBOT_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
SLEEP_INTERVAL=300  # Main loop interval in seconds

# Notification Settings
NOTIFICATION_HOURS_BEFORE_END=4  # Hours before war end to send reminders
NOTIFICATION_BATCH_DELAY=2  # Seconds between notification batches
NOTIFICATION_MAX_RETRIES=1  # Max retry attempts for failed notifications

# Hot->history migration (all optional — defaults shown; see DATABASE_ARCHITECTURE.md's
# 2026-09-01 (b)/(c)/(d) entries). The nightly walk moves ~1 day of aged-out rows per night.
# HISTORY_RETENTION_DAYS is NOT just a disk knob: a row dated D migrates N days later, so it
# decides which days of the month carry the heavy migration. CWL runs days 1-10 at ~2x volume,
# and only 71-78 keeps that load out of a CWL season while still advancing 1 day/night — read
# the config comment before changing it.
HISTORY_RETENTION_DAYS=75                     # Rolling hot-DB retention window
HISTORY_MIGRATION_NIGHTLY_ROW_BUDGET=3000000  # Primary per-run bound; 0 makes the walk a no-op
HISTORY_MIGRATION_TIME_BUDGET_MINUTES=30      # Secondary hard stop for one run

# Nightly VACUUM trigger — VACUUM runs when the free list exceeds
# max(VACUUM_MIN_FREELIST_PAGES, VACUUM_FREELIST_FRACTION * page_count). The rolling
# migration frees ~1.1 GB every night, and those pages are reused by new inserts, so a
# small trigger would VACUUM nightly for nothing (~7.5 min hard Discord block + a full
# rewrite of the DB file each time). 0 = always VACUUM (old behaviour).
VACUUM_FREELIST_FRACTION=0.15    # 15% of the file
VACUUM_MIN_FREELIST_PAGES=500    # absolute floor, for small/fresh DBs

# Monte Carlo Simulation
SIM_MULTIPROCESS_ENABLED=true   # true/false — enable multi-process parallel simulation
SIM_MAX_WORKERS=0               # 0 = all logical cores (capped at 8); >0 = use exactly that many

# CWL Clan-Config Web Bridge (CWL_CLAN_CONFIG_ACTIVITY_PLAN.md Phase B) — optional; the
# DEV or PROD pair (matching whichever mode this process runs in, same DEV/PROD split as
# DISCORD_TOKEN/DISCORD_TOKEN_DEV above) must both be set to start it. Bound to 127.0.0.1 only;
# a cloudflared tunnel makes it reachable from the Cloudflare Worker. The secret must match the
# corresponding Worker environment's BRIDGE_SECRET (wrangler secret put ... --env dev|prod).
WEB_BRIDGE_PORT_DEV=0
WEB_BRIDGE_SECRET_DEV=
WEB_BRIDGE_PORT=0
WEB_BRIDGE_SECRET=

# CWL roster-planning feature (CWL_ROSTER_PLANNING_PLAN.md). While true, CWL-related DMs
# (signup confirm/opt-out blast, enrollment/assignment notifications) are only actually
# delivered to SERVER_ADMIN's own Discord account — every other resolved recipient is
# skipped (their DB rows are still written; only DM delivery is guarded). DEV-only toggle:
# defaults to true (restricted) when unset, set to false to let DEV DM everyone too. PROD
# has NO toggle any more (tracker item #0007, 2026-08-21) — the feature is production-ready,
# so PROD always DMs every eligible player regardless of this file; there is no
# CWL_DM_RESTRICT_TO_ADMIN (unsuffixed) variable to set.
CWL_DM_RESTRICT_TO_ADMIN_DEV=true

# Production data / server paths (placeholders only - DO NOT commit real prod paths)
# Set `PROD_DATA_DIR` to the production BOT ROOT (the scripts expect data under ${PROD_DATA_DIR}/data)
# PROD_DATA_DIR and PROD_BOT_ROOT can be identical, but if different PROD_BOT_ROOT is the place where the code files reside (e.g. slow HDD) while
# PROD_DATA_DIR is where the data files reside (e.g. fast SSD). The scripts will look for data files under ${PROD_DATA_DIR}/data.
# PROD_SSD_UNC is the UNC path to PROD_DATA_DIR where the data files reside. This is used for faster access to data files on a server or network share.
PROD_DATA_DIR=<path-to-prod-bot-root>
PROD_BOT_ROOT=<path-to-prod-bot-root>
PROD_SSD_UNC=\\<SERVER_HOST>\<share>\QapBot

# Notes:
# - Never commit real tokens or passwords. Keep `.env` in .gitignore.
# - For CI, store secrets in your CI secret store instead of a file.

# --- Diagnostics (all optional, all off/auto by default) ---
# Profile the next N Phase-1 passes with cProfile, then disarm automatically.
# Writes data/logs/phase1_profile_<timestamp>.{prof,txt} and logs the top offenders.
# cProfile roughly doubles the cost of what it instruments, so use small N on PROD.
#PROFILE_PHASE1=1
# Override the asyncio.to_thread worker count (0/unset = auto: max(16, cpu_count+4)).
# Set to 6 to restore CPython's default sizing on a 2-core host.
#TO_THREAD_WORKERS=0


# Restore CPython's automatic garbage collection scheduling (default: off).
# By default QapBot disables automatic collection at startup and runs a young-generation
# gc.collect(1) per cycle, with the single full sweep in the nightly maintenance window.
# Reason: every measured Discord-responsiveness stall was an automatic gen-2 sweep
# (11/11 [LOOP-LAG] stalls matched a [GC-AUTO] pause; several exceeded Discord's 3s ACK
# deadline). Set to 1 only to A/B the policy or to debug a suspected memory-retention issue —
# expect multi-second mid-cycle pauses to return. See qapbot/docs/PERFORMANCE_TUNING.md.
# GC_AUTOMATIC=1
