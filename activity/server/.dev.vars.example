# Copy to .dev.vars (gitignored) for `wrangler dev` local testing.
# Real deployments set these with `wrangler secret put <NAME> --env dev|prod` instead —
# this file is local-only.

CLIENT_ID=your-discord-application-client-id
CLIENT_SECRET=your-discord-application-client-secret

# Phase B+ only — leave blank until the QapBot bridge API + cloudflared tunnel exist.
BRIDGE_URL=
BRIDGE_SECRET=
